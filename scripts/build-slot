#!/usr/bin/python3
"""Run a heavy build or test command in one of N machine-wide build slots.

    scripts/build-slot xcodebuild -scheme SyncCloud -derivedDataPath .dd build
    scripts/build-slot swift test --package-path Modules/Sync --filter Foo
    scripts/build-slot --exclusive sh -c '<CPU-stress flake probe>'
    scripts/build-slot --status
    scripts/build-slot --classify swift test --package-path Modules/Events   # light or heavy?

Every Claude session on this Mac (and the self-hosted CI runner beside them) shares ten cores.
More concurrent builds than that buy no throughput and make the timing-sensitive suites flake,
so sessions queue here instead. A command waits its turn, then runs with its stdin/stdout/stderr
untouched; the wrapper exits with the command's exit status, or dies of the same signal (a
core-dumping one comes back as 128+n — see RERAISED).

Turns are shared by worktree (the git toplevel of the command's cwd), not by arrival: a free slot
goes to the oldest waiter of the worktree holding the fewest slots right now; among worktrees
holding as few, to the one served least recently, then the one whose oldest waiter is oldest.
Within one worktree it is first come, first served. So a session that queues its whole landing
gate holds up another session's one narrow run by at most one command, not by all of them.

A command already queued or running from the same directory with the same arguments is refused at
once, exit 3, naming the PID it duplicates: wait for that run, or stop it first.
$BUILD_SLOT_ALLOW_DUPLICATE=1 runs a deliberate repeat.

Beside the N general slots is one light lane, which only a light command may take, so a one-minute
run need not wait out three app test runs. A light command takes the lane when it is free and its
turn among light waiters comes up (turns shared by worktree, as above), or a general slot by its
turn there. Light, by rule (light_by_rule): a `swift test` whose --filter names at most
LIGHT_FILTERS suites by name (not a pattern, nor any part of a test target's name in its
Package.swift), or of a small package (LIGHT_PACKAGES) in full; an `xcodebuild test` with at most
LIGHT_FILTERS -only-testing:Target/Suite and no build or clean action or Release
configuration. Never anything else: no build, no test-shards, no full Sync or FileExplorer run,
no --exclusive. A command light
by rule whose recent runs (the last HISTORY_RUNS, kept in history) took LIGHT_SECONDS or more at
the median is heavy. So the machine runs at most N heavy commands and one short one. The lane is
refused while an --exclusive command runs (any holder of two slots is one), and to anyone queued
behind an --exclusive waiter.

Slots are files under ~/Library/Caches/SyncCloud-build-slots/ held with flock(2). The kernel drops
a lock the moment its holder dies — SIGKILL, a crash, a stopped session — so no slot ever has to be
reclaimed by hand and a reused PID can never look like a live holder. Waiters queue the same way.
When each worktree last got a slot is kept beside them in served, a JSON file; losing it only
loses that memory.

--exclusive waits until nobody queued before it is still waiting and nothing is held, then takes
every slot, so nothing else built by a session runs beside it (a CPU-stress probe's measurement is
its own). Everyone queued behind it waits, even for a slot that is free; waiters queued before it
share the slots by worktree as above. The slot count is read on every poll.

Slot count: $BUILD_SLOTS, else the number in ~/Library/Caches/SyncCloud-build-slots/slots, else 3.
$BUILD_SLOT_TIMEOUT: give up after this many seconds of waiting, exit 75 (default: wait forever,
    reporting the holders once a minute on stderr).
$BUILD_SLOT_CFPREFSD_MS: before a test command (swift test, xcodebuild test…, test-shards), one
    flush through the user's cfprefsd agent is timed, and taking this many ms or more prints a
    warning: a month-old agent turns every local test run red (docs/flaky-tests.md). Default 50,
    fractions allowed, 0 disables. The agent is never restarted for you.
$BUILD_SLOT_NICE: nice increment for compile-only commands (default 10, 0 disables). Test runs
    are never deprioritised — several suites are timing-sensitive (docs/flaky-tests.md).

A command run under a slot sees BUILD_SLOT_HELD, so a nested build-slot runs at once instead of
waiting on its own parent. The wrapper keeps a list of the command's descendants (every
HEAL_SECONDS, and again the moment a stop signal arrives); when the command dies of a signal, or the
wrapper is being stopped, any of them still running is ended, TERM then KILL, because a killed
`swift test` can orphan a spinning test helper (docs/flaky-triage.md). A normal exit ends nothing. If the slot directory cannot be used at all, the command runs without
a slot after a warning: a broken cache directory must not stop every build on the machine.
"""

import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import time

SLOT_DIR = os.environ.get("BUILD_SLOT_DIR") or os.path.expanduser(
    "~/Library/Caches/SyncCloud-build-slots")
QUEUE_DIR = os.path.join(SLOT_DIR, "queue")
DEFAULT_SLOTS = 3
POLL_SECONDS = 1.0
HEAL_SECONDS = 2.0
REPORT_SECONDS = 60
MUTEX_REPORT_SECONDS = 10
TIMEOUT_EXIT = 75  # EX_TEMPFAIL
LIGHT = "light"  # the light lane's key among held slots; its file is slot-light, which an older
# build-slot, counting only slot-<number> files, never sees as a general slot
LIGHT_PACKAGES = {"Dashboard", "Events", "Settings", "SyncCloudCLI", "Design"}
LIGHT_FILTERS = 4  # suites a narrowed run may name and still be light
REGEX_SPECIALS = set("^$*+?()[]{}\\")  # in a --filter: a pattern, not a suite's name
XCODEBUILD_BUILDS = {"build", "build-for-testing", "clean", "analyze", "archive", "install",
                     "installsrc"}
LIGHT_SECONDS = 120
HISTORY_RUNS = 5
DUPLICATE_EXIT = 3
SERVED_DAYS = 7  # how long a worktree's last turn is remembered
FORWARDED = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT)
# A command killed by one of these is re-killed on the wrapper, so a calling shell sees the same
# death. The core-dumping signals (SIGABRT, SIGSEGV, …) come back as exit 128+n instead: re-raising
# them would file a crash report for python3 itself.
RERAISED = {signal.SIGHUP, signal.SIGINT, signal.SIGKILL, signal.SIGPIPE, signal.SIGALRM,
            signal.SIGTERM, signal.SIGUSR1, signal.SIGUSR2, signal.SIGVTALRM, signal.SIGPROF}


def note(message):
    sys.stderr.write("build-slot: %s\n" % message)
    sys.stderr.flush()


def env_number(name, default, minimum):
    text = os.environ.get(name)
    if not text:
        return default
    try:
        value = int(text.strip())
    except ValueError:
        value = minimum - 1
    if value < minimum:
        note("$%s must be a whole number of at least %d, got %r" % (name, minimum, text))
        sys.exit(2)
    return value


warned_counts = set()


def slot_count():
    if os.environ.get("BUILD_SLOTS"):
        return env_number("BUILD_SLOTS", DEFAULT_SLOTS, 1)
    path = os.path.join(SLOT_DIR, "slots")
    try:
        with open(path, errors="replace") as handle:
            text = handle.read()
    except FileNotFoundError:
        return DEFAULT_SLOTS
    try:
        if int(text.strip()) >= 1:
            return int(text.strip())
    except ValueError:
        pass
    if text not in warned_counts:  # once each: a waiter reads the file every poll
        warned_counts.add(text)
        note("%s should hold a whole number of at least 1, got %r; using %d" % (
            path, text, DEFAULT_SLOTS))
    return DEFAULT_SLOTS


def slot_path(index):
    return os.path.join(SLOT_DIR, "slot-%s" % index)


def try_lock(path, create=True):
    """An open fd holding an exclusive lock on path, or None if someone else holds it."""
    flags = os.O_RDWR | (os.O_CREAT if create else 0)
    fd = os.open(path, flags, 0o644)  # never inherited by the command (PEP 446)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return None
    except OSError:
        os.close(fd)
        raise
    return fd


class Mutex:
    """Serialises every look at the slots and the queue. Held for milliseconds at a time."""

    def __enter__(self):
        path = os.path.join(SLOT_DIR, "mutex")
        self.fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
        began = time.monotonic()
        next_report = began + MUTEX_REPORT_SECONDS
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= next_report:  # its holder is stopped (^Z) or wedged
                    note("waiting %s on %s, held by pid %s" % (
                        duration(time.monotonic() - began), path, read_text(path).strip() or "?"))
                    next_report += MUTEX_REPORT_SECONDS
                time.sleep(0.02)
        try:
            os.ftruncate(self.fd, 0)
            os.pwrite(self.fd, str(os.getpid()).encode(), 0)
        except OSError:
            pass
        return self

    def __exit__(self, *_):
        os.close(self.fd)


def read_text(path):
    try:
        with open(path, errors="replace") as handle:
            return handle.read()
    except OSError:
        return ""


def parse_record(text):
    record = {}
    for line in text.splitlines():
        key, _, value = line.partition("=")
        record[key] = value
    return record


def read_record(index):
    return parse_record(read_text(slot_path(index)))


def one_line(text):
    return text.replace("\\", "\\\\").replace("\n", "\\n")


def worktree_of(cwd):
    """The git toplevel holding cwd, or cwd itself outside a repository."""
    try:
        top = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             errors="surrogateescape", timeout=10).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        top = ""
    return top or cwd


def record_text(command, worktree, light=False):
    """What a slot file and a queue entry hold: read for display, for sharing turns by worktree,
    and argv (exact, as JSON) for refusing a duplicate. Entries made by an older build-slot are
    empty, and slot records lack worktree and argv."""
    return "pid=%d\nstarted=%f\ncwd=%s\nworktree=%s\ncommand=%s\nargv=%s\nlight=%d\n" % (
        os.getpid(), time.time(), one_line(os.getcwd()), one_line(worktree),
        one_line(" ".join(command)), json.dumps(command), light)


def write_record(fd, text):
    try:  # a full disk costs the record, never the slot
        os.ftruncate(fd, 0)
        os.pwrite(fd, text.encode("utf-8", "surrogateescape"), 0)
    except OSError:
        pass


def survey(count):
    """Under the mutex: (held, free). held lists (index, record) for every held slot, numbered
    past count too, so lowering the count never hides a running build; free maps each free index
    up to count to an fd now holding it, which the caller must keep or close."""
    indices = set(range(1, count + 1))
    for name in os.listdir(SLOT_DIR):
        if name.startswith("slot-") and name[5:].isdigit():
            indices.add(int(name[5:]))
    held, free = [], {}
    for index in sorted(indices):
        try:
            fd = try_lock(slot_path(index), create=index <= count)
        except FileNotFoundError:  # a spare slot file deleted since the listing
            continue
        if fd is None:
            held.append((index, read_record(index)))
        elif index <= count:
            free[index] = fd
        else:
            os.close(fd)
    return held, free


def light_survey():
    """Under the mutex: (record, None) if the light lane is held, else (None, an fd holding it)."""
    fd = try_lock(slot_path(LIGHT))
    return (read_record(LIGHT), None) if fd is None else (None, fd)


def close_all(fds):
    for fd in fds.values():
        os.close(fd)


def stopped_pids(pids):
    """The pids, of those given, that are stopped (^Z, SIGSTOP), so a waiter cannot hold up the line
    behind it. One ps for the whole queue."""
    if not pids:
        return set()
    try:
        listing = subprocess.run(["ps", "-o", "pid=,state=", "-p", ",".join(pids)],
                                 stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                 errors="replace").stdout
    except OSError:
        return set()
    return {fields[0] for fields in map(str.split, listing.splitlines())
            if len(fields) == 2 and fields[1].startswith("T")}


EXCLUSIVE_MARK = "-x-"  # in an --exclusive waiter's queue entry: 00…0123-x-4567


def entry_name(exclusive):
    return "%020d%s%d" % (time.time_ns(), EXCLUSIVE_MARK if exclusive else "-", os.getpid())


def read_queue():
    """Under the mutex: every live waiter, oldest first, as its record plus name, pid, group (its
    worktree), exclusive and stopped. A dead waiter's entry is unlocked, and is removed here; a
    stopped one is passed over until it resumes, when it has its place back."""
    try:
        names = sorted(os.listdir(QUEUE_DIR))
    except FileNotFoundError:
        return []
    waiters = []
    for name in names:
        path = os.path.join(QUEUE_DIR, name)
        try:
            fd = try_lock(path, create=False)
        except FileNotFoundError:
            continue
        if fd is not None:
            os.unlink(path)
            os.close(fd)
            continue
        waiter = parse_record(read_text(path))
        waiter.update(name=name, pid=name.rpartition("-")[2], exclusive=EXCLUSIVE_MARK in name,
                      group=waiter.get("worktree") or "?" + name)  # an older build-slot's entry
        waiters.append(waiter)
    stopped = stopped_pids([waiter["pid"] for waiter in waiters if waiter["pid"].isdigit()])
    for waiter in waiters:
        waiter["stopped"] = waiter["pid"] in stopped
    return waiters


def held_group(record):
    return record.get("worktree") or record.get("cwd", "?")


def holdings_of(held):
    holdings = {}
    for _, record in held:
        group = held_group(record)
        holdings[group] = holdings.get(group, 0) + 1
    return holdings


def served_path():
    return os.path.join(SLOT_DIR, "served")


def read_served():
    """{worktree: when it last got a slot}, so turns rotate between worktrees that hold none."""
    try:
        served = json.loads(read_text(served_path()))
        return {group: float(when) for group, when in served.items()}
    except (ValueError, TypeError, AttributeError):
        return {}


def note_served(served, group):
    now = time.time()
    served = {g: when for g, when in served.items() if now - when < SERVED_DAYS * 86400}
    served[group] = now
    scratch = "%s.%d" % (served_path(), os.getpid())
    try:
        with open(scratch, "w") as handle:
            json.dump(served, handle)
        os.replace(scratch, served_path())
    except OSError:
        pass


def schedule(waiters, held, served, room=None):
    """The live, unstopped waiters (oldest first) in the order free slots will go to them.

    Each turn goes to the oldest waiter of the worktree holding fewest general slots, counting the
    turns already handed out ahead of it; ties go to the worktree served least recently, then to
    the oldest waiter. The lane's short runs do not count as holdings: the first build-slot to
    share turns did not count them, and every copy must agree on whose turn it is.

    An --exclusive waiter is a wall: those before it are ordered among themselves, then it, then
    those after it, as if nothing were held.

    An older build-slot's waiter takes a slot only once fewer waiters are ahead of it in arrival
    order than slots are free; it is ordered here only then (room given), so it is never handed a
    turn it will not take while a slot stands idle."""
    holdings = holdings_of(held)
    served = dict(served)
    tick = max(served.values(), default=0.0)
    order, segment = [], []

    def drain():
        nonlocal tick
        queues = {}
        for waiter in segment:
            queues.setdefault(waiter["group"], []).append(waiter)
        while queues:
            group = min(queues, key=lambda g: (holdings.get(g, 0), served.get(g, 0.0),
                                               queues[g][0]["name"]))
            order.append(queues[group].pop(0))
            if not queues[group]:
                del queues[group]
            holdings[group] = holdings.get(group, 0) + 1
            tick += 1
            served[group] = tick
        segment.clear()

    for position, waiter in enumerate(waiters):
        if waiter["exclusive"]:
            drain()
            order.append(waiter)
            holdings.clear()
        elif "worktree" in waiter or room is None or position < room:
            segment.append(waiter)
    drain()
    return order


def duplicate_of(command, waiters, held):
    """(pid, "queued" or "running") of a live waiter or holder with this cwd and argv, if any."""
    cwd, argv, shown = one_line(os.getcwd()), json.dumps(command), one_line(" ".join(command))

    def same(record):
        if record.get("cwd") != cwd:
            return False
        if "argv" in record:
            return record["argv"] == argv
        return record.get("command") == shown  # held under an older build-slot

    for waiter in waiters:
        if same(waiter):
            return waiter["pid"], "queued"
    for _, record in held:
        if same(record):
            return record.get("pid", "?"), "running"
    return None


def duration(seconds):
    seconds = int(seconds)
    if seconds < 3600:
        return "%dm%02ds" % divmod(seconds, 60)
    return "%dh%02dm" % (seconds // 3600, seconds % 3600 // 60)


def place(cwd):
    marker = "/.claude/worktrees/"
    if marker in cwd:
        return cwd.split(marker, 1)[1].split("/", 1)[0]
    home = os.path.expanduser("~")
    return "~" + cwd[len(home):] if cwd.startswith(home) else cwd


def shorten(command, width):
    return command if len(command) <= width else command[:width - 1] + "…"


def since(record):
    try:
        return duration(time.time() - float(record.get("started", "")))
    except ValueError:
        return "?"


def describe(index, record, width=70):
    return "[%s] pid %s, %s, %s: %s" % (
        index, record.get("pid", "?"), place(record.get("worktree") or record.get("cwd", "?")),
        since(record), shorten(record.get("command", "?"), width))


def make_entry(entry_path, text):
    """Under the mutex, so none is pruned or read half-made: the queue entry, created and locked."""
    fd = os.open(entry_path, os.O_RDWR | os.O_CREAT | os.O_EXCL, 0o644)
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    write_record(fd, text)
    return fd


def acquire(command, exclusive, worktree, light=False):
    """Refuse a duplicate, queue, then take a slot once this waiter's turn (schedule) is among the
    slots free and no --exclusive one is ahead — or, light, the light lane once it is free and this
    is the first light waiter in turn — or, if exclusive, every slot and the lane, once nobody is
    ahead and nothing is held. Returns ({index: fd}, the slot count it was taken under).

    A poll with nothing this waiter could take reads only the slot files, not the queue, so a long
    line costs little CPU while it waits. Each poll reads the count afresh, so a changed slots file
    reaches waiters already in line, and remakes the directory and this waiter's entry, under its
    first name and so its first place, if a cache sweep took them: the sweep otherwise sent every
    waiter on without a slot."""
    timeout = env_number("BUILD_SLOT_TIMEOUT", 0, 0)
    began = time.monotonic()
    next_report = began
    text = record_text(command, worktree, light)
    entry = entry_path = entry_fd = None
    ahead = 0
    try:
        os.makedirs(QUEUE_DIR, exist_ok=True)
        with Mutex():
            if not os.environ.get("BUILD_SLOT_ALLOW_DUPLICATE"):
                held, free = survey(slot_count())
                close_all(free)
                lane, lane_fd = light_survey()
                if lane_fd is not None:
                    os.close(lane_fd)
                twin = duplicate_of(command, read_queue(),
                                    held + ([(LIGHT, lane)] if lane else []))
                if twin:
                    note("pid %s already has this command %s in %s: %s\n"
                         "build-slot: wait for that run to finish, or stop it first (kill %s). "
                         "BUILD_SLOT_ALLOW_DUPLICATE=1 runs a deliberate repeat." % (
                             twin[0], twin[1], place(worktree), shorten(" ".join(command), 120),
                             twin[0]))
                    sys.exit(DUPLICATE_EXIT)
            entry = entry_name(exclusive)
            entry_path = os.path.join(QUEUE_DIR, entry)
            entry_fd = make_entry(entry_path, text)
    except OSError:  # a full disk: no place in line, so wait behind everyone, slots still honoured
        entry = None
    try:
        while True:
            count = slot_count()
            os.makedirs(QUEUE_DIR, exist_ok=True)
            try:
                with Mutex():
                    if entry is not None and not os.path.exists(entry_path):  # a sweep took it
                        try:
                            fd = make_entry(entry_path, text)
                            os.close(entry_fd)
                            entry_fd = fd
                        except OSError:
                            pass
                    held, free = survey(count)
                    lane, lane_fd = light_survey()
                    if not exclusive and exclusive_running(held, lane):
                        # Nothing runs beside it, not even in a slot added since it began.
                        close_all(free)
                        free = {}
                        if lane_fd is not None:
                            os.close(lane_fd)
                            lane_fd = None
                    if exclusive:
                        possible = not held and lane_fd is not None
                    else:
                        possible = free or (light and lane_fd is not None)
                    if not possible and time.monotonic() < next_report:
                        close_all(free)
                        if lane_fd is not None:
                            os.close(lane_fd)
                        taken = None
                    else:
                        taken = take(entry, exclusive, light, count, held, free, lane_fd)
                        ahead = taken.pop("ahead")
                    if taken:
                        # started is now, not when it queued
                        held_text = record_text(command, worktree, light)
                        for fd in taken.values():
                            write_record(fd, held_text)
                        note_served(read_served(), worktree)
                        waited = time.monotonic() - began
                        if waited >= POLL_SECONDS:
                            note("got slot %s after waiting %s" % (
                                ",".join(map(str, sorted(taken, key=str))), duration(waited)))
                        return taken, count
            except FileNotFoundError:  # a sweep took the directory mid-poll; the next remakes it
                time.sleep(POLL_SECONDS)
                continue
            everyone = held + ([(LIGHT, lane)] if lane else [])
            now = time.monotonic()
            if timeout and now - began >= timeout:
                note("gave up after %s: %d of %d slots held, %d waiting ahead" % (
                    duration(now - began), len(held), count, ahead))
                sys.exit(TIMEOUT_EXIT)
            if now >= next_report:
                line = "first in line" if not ahead else "%d ahead in line" % ahead
                mine = holdings_of(everyone).get(worktree, 0)
                if mine:
                    line += ", this worktree holding %d" % mine
                note("waiting %s%s%s, %s; %d of %d slots held — %s%s" % (
                    duration(now - began), " for every slot" if exclusive else "",
                    " (light: a general slot or the light lane)" if light else "", line,
                    len(held), count,
                    "; ".join(describe(i, record) for i, record in everyone) or "none",
                    "; the slot directory is new, so running builds get %ds to re-take their "
                    "slots first" % (HEAL_SECONDS + POLL_SECONDS) if settling() else ""))
                next_report = now + REPORT_SECONDS
            time.sleep(POLL_SECONDS)
    finally:
        if entry_fd is not None:
            try:
                os.unlink(entry_path)
            except FileNotFoundError:
                pass
            os.close(entry_fd)


def settling():
    """True for HEAL_SECONDS + POLL_SECONDS after the slot directory is made: at first use, or
    after a cache sweep took it. Then every holder's slot file is new and unlocked until its next
    heal re-takes it, so nobody takes a slot until they have had the chance — not a waiter already
    in line, not a newcomer."""
    try:
        made = os.stat(SLOT_DIR).st_birthtime
    except (OSError, AttributeError):
        return False
    return time.time() - made < HEAL_SECONDS + POLL_SECONDS


def exclusive_running(held, lane):
    """True while an --exclusive command runs: only one holds two slots at once (counting the lane;
    an older build-slot's holds every general slot and not the lane)."""
    pids = [record.get("pid", "") for _, record in held] + ([lane.get("pid", "")] if lane else [])
    pids = [pid for pid in pids if pid.isdigit()]
    return len(pids) != len(set(pids))


def take(entry, exclusive, light, count, held, free, lane_fd):
    """Under the mutex, one poll's decision: {index: fd} of the slots taken (the rest closed),
    plus "ahead", this waiter's place in line."""
    live = [waiter for waiter in read_queue() if not waiter["stopped"]]
    served = read_served()
    room = count - len(held)
    order = schedule(live, held, served, room)
    ahead = next((i for i, w in enumerate(order) if w["name"] == entry), len(order))
    turns, light_turn = [], None  # who gets the free slots, and the lane: none past an exclusive
    for waiter in order:
        if waiter["exclusive"]:
            break
        if len(turns) < room:
            turns.append(waiter["name"])
        if light_turn is None and waiter.get("light") == "1":
            light_turn = waiter["name"]
    taken = {}
    if settling():
        pass
    elif exclusive:
        first = not any(w["name"] < entry for w in live) if entry else not live
        if first and not held and len(free) == count and lane_fd is not None:
            taken, free = dict(free, **{LIGHT: lane_fd}), {}
            lane_fd = None
    elif light and lane_fd is not None and light_turn == entry and entry is not None:
        taken, lane_fd = {LIGHT: lane_fd}, None
    elif free and (entry in turns if ahead < len(order) else
                   ahead < room and not any(w["exclusive"] for w in order)):
        index = min(free)
        taken = {index: free.pop(index)}
    close_all(free)
    if lane_fd is not None:
        os.close(lane_fd)
    taken["ahead"] = ahead
    return taken


class Holding:
    """The held slots. If a slot's file is deleted (a cache sweep), a newcomer could lock a fresh
    file of the same name and exceed the count, so every HEAL_SECONDS each is checked to still be
    the file it locked, and a lost one is replaced by a free slot."""

    def __init__(self, count, text, slots):
        self.count, self.text, self.slots = count, text, slots

    def heal(self):
        lost = []
        for index, fd in self.slots.items():
            try:
                if os.stat(slot_path(index)).st_ino == os.fstat(fd).st_ino:
                    continue
            except FileNotFoundError:
                pass
            lost.append(index)
        if not lost:
            return
        try:
            os.makedirs(SLOT_DIR, exist_ok=True)
            with Mutex():
                _, free = survey(self.count)
                for index in lost:
                    os.close(self.slots.pop(index))
                    if index == LIGHT:
                        _, fd = light_survey()
                        if fd is not None:  # else a newcomer took the lane; nothing to retake
                            self.slots[LIGHT] = fd
                            write_record(fd, self.text)
                            note("slot directory was removed under a running build; "
                                 "re-took the light lane")
                    elif free:
                        new = min(free)
                        self.slots[new] = free.pop(new)
                        write_record(self.slots[new], self.text)
                        note("slot directory was removed under a running build; "
                             "re-took slot %d" % new)
                    else:
                        note("slot directory was removed under a running build, and every slot "
                             "has been taken since; running on without one")
                close_all(free)
        except OSError:
            pass


def without_arch(command):
    args = list(command)
    if args and os.path.basename(args[0]) == "arch":  # arch -arm64 swift …
        args = args[1:]
        while args and args[0].startswith("-"):
            args = args[1:]
    return args


def option_values(args, name):
    """Every value of a `name value` or `name=value` (`name:value` for xcodebuild) option."""
    values = []
    for i, arg in enumerate(args):
        if arg == name and i + 1 < len(args):
            values.append(args[i + 1])
        elif arg.startswith(name) and arg[len(name):len(name) + 1] in ("=", ":"):
            values.append(arg[len(name) + 1:])
    return values


def test_targets(package):
    """The test target names a package declares, or None if its Package.swift cannot be read."""
    try:
        with open(os.path.join(package, "Package.swift"), errors="replace") as handle:
            text = handle.read()
    except OSError:
        return None
    return re.findall(r'\.testTarget\(\s*name:\s*"([^"]+)"', text)


def light_by_rule(command):
    """(light, why) by the command's shape alone: see the header."""
    args = without_arch(command)
    tool = os.path.basename(args[0]) if args else ""
    if tool == "swift" and args[1:2] == ["test"]:
        package = (option_values(args, "--package-path") or [os.getcwd()])[-1]
        filters = option_values(args, "--filter")
        if filters:
            names = [name for f in filters for name in f.split("|")]
            if len(names) > LIGHT_FILTERS:
                return False, "--filter names %d suites (light up to %d)" % (
                    len(names), LIGHT_FILTERS)
            targets = test_targets(package)
            if targets is None:
                return False, "no Package.swift in %s to tell a suite from a test target" % package
            for name in names:
                # A filter is a regex matched against Target.Suite/test: a pattern, or a piece of
                # a target's name, runs all of that target.
                stem = name.rstrip("./")
                if len(stem) < 3 or set(stem) & REGEX_SPECIALS or any(
                        stem in target for target in targets):
                    return False, ("--filter %r is a pattern or part of a target's name, so it "
                                   "may run a whole test target" % name)
            return True, "--filter names %d suite%s (light up to %d)" % (
                len(names), "" if len(names) == 1 else "s", LIGHT_FILTERS)
        name = os.path.basename(os.path.normpath(package))
        return name in LIGHT_PACKAGES, "a full run of %s (light: %s)" % (
            name, ", ".join(sorted(LIGHT_PACKAGES)))
    if tool == "xcodebuild":
        if not {"test", "test-without-building"} & set(args[1:]):
            return False, "an xcodebuild build"
        if XCODEBUILD_BUILDS & set(args[1:]) or "release" in [
                c.lower() for c in option_values(args, "-configuration")]:
            return False, "an xcodebuild test that also builds, cleans or is Release"
        only = option_values(args, "-only-testing")
        if not only:
            return False, "an xcodebuild test without -only-testing"
        if not all("/" in name for name in only):
            return False, "-only-testing names a whole test target"
        return len(only) <= LIGHT_FILTERS, "-only-testing names %d (light up to %d)" % (
            len(only), LIGHT_FILTERS)
    return False, "not a swift test or xcodebuild test"


def history_path():
    return os.path.join(SLOT_DIR, "history")


def shape(command, worktree):
    """A command's key in history, the same from every worktree."""
    return "%s: %s" % (os.path.relpath(os.getcwd(), worktree), " ".join(command))


def read_history():
    try:
        history = json.loads(read_text(history_path()))
        return {key: [float(t) for t in runs] for key, runs in history.items()}
    except (ValueError, TypeError, AttributeError):
        return {}


def classify(command, worktree):
    """(light, why): light by rule, unless its recent runs took LIGHT_SECONDS at the median."""
    light, why = light_by_rule(command)
    runs = read_history().get(shape(command, worktree), [])
    if light and runs:
        median = sorted(runs)[len(runs) // 2]
        if median >= LIGHT_SECONDS:
            return False, "%s, but its last %d runs took %s at the median" % (
                why, len(runs), duration(median))
        why += "; its last %d runs took %s at the median" % (len(runs), duration(median))
    return light, why


def note_run(command, worktree, seconds):
    """Under the mutex: add a light-by-rule command's run time to history."""
    key = shape(command, worktree)
    history = read_history()
    history[key] = (history.pop(key, []) + [round(seconds, 1)])[-HISTORY_RUNS:]
    if len(history) > 500:  # the least recently run first: dicts keep insertion order
        history = dict(list(history.items())[-500:])
    scratch = "%s.%d" % (history_path(), os.getpid())
    try:
        with open(scratch, "w") as handle:
            json.dump(history, handle)
        os.replace(scratch, history_path())
    except OSError:
        pass


def compile_only(command):
    """True for a build that runs no tests, so a lower priority cannot starve a timing check."""
    args = without_arch(command)
    if not args:
        return False
    tool = os.path.basename(args[0])
    if tool == "xcodebuild":
        return not ({"test", "test-without-building"} & set(args[1:]))
    if tool == "swift":
        return len(args) > 1 and args[1] == "build"
    return False


def runs_tests(command):
    """True for a command that runs test suites: `swift test`, `xcodebuild test…`, test-shards."""
    args = without_arch(command)
    if not args:
        return False
    tool = os.path.basename(args[0])
    if tool == "xcodebuild":
        return bool({"test", "test-without-building"} & set(args[1:]))
    if tool == "swift":
        return len(args) > 1 and args[1] == "test"
    return tool == "test-shards"


CFPREFSD_PROBE = "com.abhishekgirish.SyncCloud.build-slot-probe"  # one name, so the probe never
# adds a domain of its own to the agent it is timing


def flush_milliseconds():
    """The fastest of three flushes of one defaults domain through the user's cfprefsd agent.

    The SPI `wipeDefaultsSuite` calls after every test's scratch suite. Its cost grows with every
    domain the agent has cached; a fresh agent answers in about 1 ms, a month-old one in hundreds
    (docs/flaky-tests.md, "A cfprefsd agent that has cached every scratch suite makes each defaults
    wipe a quarter-second wait"). The fastest of three, so a load spike cannot fake a slow agent.
    None when the SPI is gone or anything fails: the check must never stop a build.
    """
    try:
        import ctypes
        cf = ctypes.CDLL("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
        flush = cf._CFPreferencesFlushCachesForIdentifier
        make = cf.CFStringCreateWithCString
        make.restype = ctypes.c_void_p
        make.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_uint32]
        number = cf.CFNumberCreate
        number.restype = ctypes.c_void_p
        number.argtypes = [ctypes.c_void_p, ctypes.c_long, ctypes.c_void_p]
        cf.CFPreferencesSetAppValue.argtypes = [ctypes.c_void_p] * 3
        cf.CFPreferencesAppSynchronize.argtypes = [ctypes.c_void_p]
        flush.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
        cf.CFRelease.argtypes = [ctypes.c_void_p]
        utf8 = 0x08000100
        domain = make(None, CFPREFSD_PROBE.encode(), utf8)
        key = make(None, b"probe", utf8)
        user = ctypes.c_void_p.in_dll(cf, "kCFPreferencesCurrentUser")
        one = ctypes.c_int32(1)
        value = number(None, 3, ctypes.byref(one))  # kCFNumberSInt32Type
        times = []
        try:
            for _ in range(3):
                cf.CFPreferencesSetAppValue(key, value, domain)
                cf.CFPreferencesAppSynchronize(domain)
                began = time.perf_counter()
                flush(domain, user)
                times.append((time.perf_counter() - began) * 1000)
        finally:
            cf.CFPreferencesSetAppValue(key, None, domain)
            cf.CFPreferencesAppSynchronize(domain)
            flush(domain, user)
            for ref in (domain, key, value):
                cf.CFRelease(ref)
            try:
                os.remove(os.path.expanduser("~/Library/Preferences/%s.plist" % CFPREFSD_PROBE))
            except OSError:
                pass
        return min(times)
    except Exception:  # noqa: BLE001 — a probe that cannot run says nothing
        return None


def cfprefsd_agent_pid():
    """The pid of this user's cfprefsd agent, or None."""
    try:
        listing = subprocess.run(["ps", "-axo", "pid=,uid=,command="], stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL, errors="replace", timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    for line in listing.splitlines():
        fields = line.split(None, 2)
        if (len(fields) == 3 and fields[0].isdigit() and fields[1] == str(os.getuid())
                and fields[2].endswith("cfprefsd agent")):
            return int(fields[0])
    return None


def check_cfprefsd():
    """Warn before a test run when cfprefsd is slow enough to turn it red.

    Never restarts the agent: it is the user's preferences daemon, so that call is theirs.
    $BUILD_SLOT_CFPREFSD_MS sets the bound in milliseconds, fractions allowed (default 50; 0
    disables the check).
    """
    text = os.environ.get("BUILD_SLOT_CFPREFSD_MS") or "50"
    try:
        bound = float(text)
    except ValueError:
        bound = -1.0
    if not bound >= 0:  # also refuses nan
        note("$BUILD_SLOT_CFPREFSD_MS must be a number of milliseconds, 0 or more, got %r" % text)
        sys.exit(2)
    if bound == 0:
        return
    took = flush_milliseconds()
    if took is None or took < bound:
        return
    pid = cfprefsd_agent_pid()
    restart = ("kill -TERM %d" % pid) if pid else "kill -TERM <your cfprefsd agent's pid>"
    note("cfprefsd took %.0f ms to flush one defaults domain (a fresh agent: about 1 ms; this "
         "warns at %g). Test runs here will go red at their waits, on any commit. Restart it, and "
         "launchd starts a fresh one: %s. See docs/flaky-tests.md, \"A cfprefsd agent that has "
         "cached every scratch suite makes each defaults wipe a quarter-second wait\"."
         % (took, bound, restart))


def tty_already_signalled():
    """True when SIGINT came from Ctrl-C, which the terminal sends to the command as well."""
    try:
        tty = os.open("/dev/tty", os.O_RDONLY)
    except OSError:
        return False
    try:
        return os.tcgetpgrp(tty) == os.getpgrp()
    except OSError:
        return False
    finally:
        os.close(tty)


def process_table():
    """{pid: (ppid, start time, command name)} for every process on the machine."""
    try:
        listing = subprocess.run(["ps", "-axo", "pid=,ppid=,lstart=,comm="],
                                 stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                 errors="replace").stdout
    except OSError:
        return {}
    table = {}
    for line in listing.splitlines():
        fields = line.split(None, 7)  # pid, ppid, five lstart words, comm
        if len(fields) == 8 and fields[0].isdigit() and fields[1].isdigit():
            table[int(fields[0])] = (int(fields[1]), " ".join(fields[2:7]), fields[7])
    return table


def descendants(root, table=None):
    """{pid: (start time, command name)} for root's live descendants, root excluded."""
    table = process_table() if table is None else table
    children = {}
    for pid, (ppid, _, _) in table.items():
        children.setdefault(ppid, []).append(pid)
    found, frontier = {}, list(children.get(root, []))
    while frontier:
        pid = frontier.pop()
        if pid not in found:
            found[pid] = table[pid][1:]
            frontier.extend(children.get(pid, []))
    return found


def end_leftovers(seen):
    """End every process in seen that is still the same process (start times match), and
    anything it has since started."""
    def alive():
        table = process_table()
        pids = [pid for pid, (start, _) in seen.items()
                if pid in table and table[pid][1] == start]
        for pid in list(pids):
            pids.extend(descendants(pid, table))
        return sorted(set(pids)), table

    pids, table = alive()
    if not pids:
        return
    note("ending what the command left running: %s" % ", ".join(
        "%d %s" % (pid, os.path.basename(table[pid][2])) for pid in pids))
    for signum in (signal.SIGTERM, signal.SIGKILL):
        for pid in pids:
            try:
                os.kill(pid, signum)
            except (ProcessLookupError, PermissionError):
                pass
        deadline = time.monotonic() + 2
        while time.monotonic() < deadline:
            pids, _ = alive()
            if not pids:
                return
            time.sleep(0.1)


def run(command, env, nice, holding=None):
    # Only the outermost run tracks descendants; a nested one's are already in its parent's tree.
    state = {"child": None, "pending": [], "signalled": False, "seen": {}}

    def forward(signum, _frame):
        state["signalled"] = True
        if state["child"] is None:
            state["pending"].append(signum)
            return
        if holding:  # catch whatever started since the last look, before anything is orphaned
            state["seen"].update(descendants(state["child"].pid))
        if signum == signal.SIGINT and tty_already_signalled():
            return
        try:
            state["child"].send_signal(signum)
        except ProcessLookupError:
            pass

    # Installed before the spawn so no signal lands in between. exec resets a caught signal to its
    # default in the command; a signal the caller ignored is left alone, and stays ignored there.
    for signum in FORWARDED:
        if signal.getsignal(signum) is not signal.SIG_IGN:
            signal.signal(signum, forward)
    preexec = (lambda: os.nice(nice)) if nice else None
    try:
        child = subprocess.Popen(command, env=env, preexec_fn=preexec)
    except FileNotFoundError:
        note("%s: command not found" % command[0])
        return 127
    except PermissionError:
        note("%s: permission denied" % command[0])
        return 126
    except OSError as error:  # an exec format error, say: the shell's 126, not a traceback
        note("%s: %s" % (command[0], error.strerror))
        return 126
    state["child"] = child
    for signum in state["pending"]:
        forward(signum, None)
    while True:
        try:
            status = child.wait(timeout=HEAL_SECONDS if holding else None)
            break
        except subprocess.TimeoutExpired:
            holding.heal()
            state["seen"].update(descendants(child.pid))
    if holding and (status < 0 or state["signalled"]):
        end_leftovers(state["seen"])
    if status < 0:
        signum = -status
        if signum in RERAISED:
            sys.stdout.flush()
            if signum != signal.SIGKILL:  # SIGKILL's handler cannot be set; it is the default
                signal.signal(signum, signal.SIG_DFL)
            os.kill(os.getpid(), signum)
        return 128 + signum
    return status


def fill_in_older(waiter):
    """For --status only: an older build-slot's queue entry is empty, so read its worktree and
    command off the waiting process, and its start off the entry's name."""
    if not waiter["pid"].isdigit():
        return
    try:
        cwd = subprocess.run(["lsof", "-a", "-d", "cwd", "-p", waiter["pid"], "-Fn"],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             errors="surrogateescape").stdout
        line = subprocess.run(["ps", "-o", "command=", "-p", waiter["pid"]],
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                              errors="replace").stdout.strip()
    except OSError:
        return
    cwd = next((l[1:] for l in cwd.splitlines() if l.startswith("n")), "")
    if cwd:  # shown under its worktree, but its turn stays first come, first served (schedule)
        waiter["shown_group"] = worktree_of(cwd)
    if "build-slot " in line:
        waiter["command"] = line.split("build-slot ", 1)[1]
    stamp = waiter["name"].partition("-")[0]
    if stamp.isdigit():
        waiter["started"] = str(int(stamp) / 1e9)


def status():
    try:
        os.makedirs(SLOT_DIR, exist_ok=True)
        count = slot_count()
        with Mutex():
            held, free = survey(count)
            close_all(free)
            lane, lane_fd = light_survey()
            if lane_fd is not None:
                os.close(lane_fd)
            waiters = read_queue()
            served = read_served()
    except OSError as error:
        note("cannot use %s: %s" % (SLOT_DIR, error))
        return 1
    for waiter in waiters:
        if "argv" not in waiter:
            fill_in_older(waiter)
    live = [waiter for waiter in waiters if not waiter["stopped"]]
    print("%d of %d slots held, %d waiting, light lane %s (%s)" % (
        len(held), count, len(live), "held" if lane else "free", SLOT_DIR))
    for index, record in held:
        print("  " + describe(index, record, width=200))
    if lane:
        print("  " + describe(LIGHT, lane, width=200))
    if not waiters:
        return 0
    turn = {waiter["name"]: n for n, waiter in enumerate(schedule(live, held, served), 1)}
    if lane:  # shown as held, though it does not count toward turns (schedule)
        held = held + [(LIGHT, lane)]
    groups = {}
    for waiter in waiters:
        groups.setdefault(waiter.get("shown_group", waiter["group"]), []).append(waiter)
    holdings = holdings_of(held)
    print("waiting, by worktree; #n is the turn each would get as slots free:")
    for group in sorted(groups, key=lambda g: min(turn.get(w["name"], len(turn) + 1)
                                                  for w in groups[g])):
        queued = groups[group]
        name = "(worktree unknown)" if group.startswith("?") else place(group)
        print("  %s: holds %d, %d waiting" % (name, holdings.get(group, 0), len(queued)))
        for waiter in queued:
            print("    %-8s pid %s, waited %s: %s%s%s" % (
                "#%d" % turn[waiter["name"]] if waiter["name"] in turn else "stopped",
                waiter["pid"], since(waiter), "--exclusive " if waiter["exclusive"] else
                "(light) " if waiter.get("light") == "1" else "",
                shorten(waiter.get("command", "?"), 200),
                "" if "argv" in waiter else "  [older build-slot]"))
    return 0


def main(argv):
    if signal.getsignal(signal.SIGINT) is signal.default_int_handler:
        signal.signal(signal.SIGINT, signal.SIG_DFL)  # die of ^C while waiting, no traceback
    if not argv or argv[0] in ("-h", "--help"):
        sys.stdout.write(__doc__)
        return 0 if argv else 2
    if argv[0] == "--status":
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # quiet under `--status | head -1`
        return status()
    if argv[0] == "--classify":
        light, why = classify(argv[1:], worktree_of(os.getcwd()))
        print("%s: %s" % ("light" if light else "heavy", why))
        return 0
    exclusive = argv[0] == "--exclusive"
    if exclusive:
        argv = argv[1:]
    if argv and argv[0] == "--":
        argv = argv[1:]
    if not argv:
        note("no command given")
        return 2
    nice = env_number("BUILD_SLOT_NICE", 10, 0) if compile_only(argv) else 0
    if os.environ.get("BUILD_SLOT_HELD"):
        return run(argv, os.environ, nice)
    if runs_tests(argv):
        check_cfprefsd()
    try:
        os.makedirs(SLOT_DIR, exist_ok=True)
        worktree = worktree_of(os.getcwd())
        by_rule = not exclusive and light_by_rule(argv)[0]
        light = by_rule and classify(argv, worktree)[0]
        slots, count = acquire(argv, exclusive, worktree, light)
    except OSError as error:
        note("cannot use %s (%s); running without a slot" % (SLOT_DIR, error))
        return run(argv, os.environ, nice)
    # its fds hold the slots until this process ends
    holding = Holding(count, record_text(argv, worktree, light), slots)
    held = ",".join(map(str, sorted(slots, key=str)))
    began = time.monotonic()
    code = run(argv, dict(os.environ, BUILD_SLOT_HELD=held), nice, holding)
    if by_rule and code < 128:  # a run cut short by a signal says nothing of its length
        try:
            with Mutex():
                note_run(argv, worktree, time.monotonic() - began)
        except OSError:
            pass
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

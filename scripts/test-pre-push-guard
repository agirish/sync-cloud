#!/bin/bash
# Tests for scripts/pre-push-guard. Pushes to a throwaway bare remote from a throwaway clone with
# the guard installed as its pre-push hook; never touches this repository. Takes a few seconds;
# prints one line per check and exits non-zero if any check fails.
set -u
GUARD="$(cd "$(dirname "$0")" && pwd)/pre-push-guard"
WORK=$(mktemp -d "${TMPDIR:-/tmp}/pre-push-guard-test.XXXXXX")
trap 'rm -rf "$WORK"' EXIT
failures=0

check() {  # check <description> <command…>
  local what=$1; shift
  if "$@"; then echo "ok   - $what"; else echo "FAIL - $what"; failures=$((failures + 1)); fi
}

# Invented names only: this file is public. Line 3 is short, to check binary files skip it. Line 5
# is the owner, whose identifiers are allowed; spelled in halves so the guard passes this file.
owner=$(printf '%s%s' abhi shek); Owner=$(printf '%s%s' Abhi shek)
printf '%s\n' Zorblax Quintessa Vex '' "$owner" > "$WORK/names.txt"
export SYNCCLOUD_SCRUB_NAMES="$WORK/names.txt"

git init -q --bare "$WORK/remote.git"
git init -q -b main "$WORK/clone"
cd "$WORK/clone" || exit 1
git config user.name test && git config user.email test@example.com
git remote add origin "$WORK/remote.git"
echo one > f && git add f && git commit -qm "First" && git push -q origin main
PRE_PUSH_GUARD_SOURCE="$GUARD" "$GUARD" --install > /dev/null

remote_main() { git --git-dir="$WORK/remote.git" rev-parse main; }
pushes() { git push -q origin "$@" 2> /dev/null; }
refused() { ! git push -q origin "$@" 2> /dev/null; }
edit() { echo "$RANDOM" >> f && git add f && git commit -qm "$1"; }

edit "Add a real change"
check "a real commit reaches main" pushes main

before=$(remote_main)
git commit -q --allow-empty -m "WIP: task"
check "an empty WIP commit is refused" refused main
check "the refused push left main where it was" test "$(remote_main)" = "$before"
edit "Land the work on top"
check "a real commit on top of it does not carry it through" refused main
git checkout -q -b clean "$before" && edit "Land the work, squashed"
check "the squashed branch's fast-forward is accepted" pushes clean:main
git checkout -q -B main clean

git commit -q --allow-empty -m "Note something"
check "an empty commit with an ordinary subject is refused" refused main
git checkout -q -B main origin/main

for subject in "wip fix" "checkpoint before mutation testing" "fixup! Add a real change" \
               "squash! Add a real change" "amend! Add a real change"; do
  edit "$subject"
  check "a non-empty '$subject' is refused" refused main
  git checkout -q -B main origin/main
done

for subject in "Wipe the test suites" "Explain why WIP commits reached main" "Checkpointing is fine"; do
  edit "$subject"
  check "'$subject' is accepted" pushes main
done

git checkout -q -b side && echo side > g && git add g && git commit -qm "Side"
git checkout -q main && edit "Main side"
git merge -q --no-edit side 2> /dev/null
check "a merge commit is refused" refused main
git checkout -q -B main origin/main

git checkout -q -b scratch && git commit -q --allow-empty -m "WIP: scratch"
check "a WIP commit on another branch is accepted" pushes scratch
check "a new maintenance line carrying it is refused" refused scratch:v9.x
git checkout -q main
check "a tag on it is accepted" pushes "$(git tag t1 && echo refs/tags/t1)"
check "deleting a branch is accepted" pushes :scratch
git checkout -q main

# main's own history holds old WIP commits. A new line cut from main, pushed in the same push as a
# new main commit, must be checked against main, not against everything.
git commit -q --allow-empty -m "WIP: an old one" && git push -q --no-verify origin main
edit "A new real commit"
check "a new line cut from main, beside a main push, is accepted" pushes main main:v7.x

# Private names.
git push -q origin main 2> /dev/null
fresh() { git checkout -q -B main origin/main; }
says() { echo "$1" >> notes && git add notes && git commit -qm "${2:-Add notes}"; }

for line in "met Zorblax today" "ZORBLAX" "zorblax" "say hi toZorblax" "zorblaxKeys" "Vex" \
            "x_Zorblax_y" "SurZorblax" "seen at /Users/abhishek and by Zorblax" "$Owner wrote this"; do
  fresh; says "$line"
  check "an added line '$line' is refused" refused main
done
fresh
for line in "Zorblaxes" "Quintessential" "Surzorblax" "VEXED" "see /Users/abhishek/Projects" \
            "com.abhishekgirish.SyncCloud" "github.com/agirish/sync-cloud" "-Users-abhishek-Projects"; do
  says "$line"
  check "an added line '$line' is accepted" pushes main
done

before=$(remote_main)
fresh; says "Zorblax"
check "the refused name push left main where it was" refused main
check "…and main is unchanged" test "$(remote_main)" = "$before"
out=$(git push origin main 2>&1)
check "a refusal names the list's line, not the name" \
  bash -c 'echo "$1" | grep -q "notes:[0-9]* (name #1)" && ! echo "$1" | grep -qi zorblax' _ "$out"

fresh; says "nothing private" "Thank Quintessa for the review"
check "a name in a commit message is refused" refused main
fresh; mkdir -p d && echo ok > d/Quintessa.txt && git add d && git commit -qm "Add a file"
check "a name in a file path is refused" refused main
fresh; echo ok > 'odd"Zorblax.txt' && git add . && git commit -qm "Add an oddly named file"
check "a name in a path git quotes is refused" refused main
fresh; echo Zorblax > 'odd"plain.txt' && git add . && git commit -qm "Add an oddly named file"
check "a name inside a file git quotes the path of is refused" refused main
fresh; git checkout -q -b named && says "Zorblax"
check "a name on a branch other than main is refused" refused named
fresh; says "Zorblax" && says "nobody" && sed -i '' '/Zorblax/d' notes && git commit -qam "Drop it"
check "a name added and removed within the push is refused" refused main
fresh; says "Zorblax" && git push -q --no-verify origin main && sed -i '' '/Zorblax/d' notes &&
  git commit -qam "Scrub a name"
check "removing a name is accepted" pushes main
fresh; git tag -a t2 -m "Cut for Quintessa"
check "a name in a tag's message is refused" refused refs/tags/t2
git tag -d t2 > /dev/null

fresh; printf 'x\000Quintessa\000' > b.bin && git add b.bin && git commit -qm "Add a binary"
check "a long name inside a binary file is refused" refused main
fresh; printf 'x\000Vex\000' > c.bin && git add c.bin && git commit -qm "Add a binary"
check "a short name inside a binary file is accepted" pushes main
fresh; printf 'y\000Quintessa\000' > e.bin && git add e.bin && git commit -qm "Add a binary" &&
  git push -q --no-verify origin main && printf 'more' >> e.bin && git commit -qam "Grow it"
check "a binary file that already held the name is accepted when it changes" pushes main

fresh; git checkout -q -b side2 && echo Zorblax > side.txt && git add side.txt && git commit -qm "Side" && git checkout -q main && says "other" &&
  git merge -q --no-edit side2 2> /dev/null && git branch -q -m main merged && git checkout -q -b main2
check "a merge bringing in a name is refused on a side branch" refused main2:topic
fresh

says "plain"
check "a missing list refuses the push" bash -c "! SYNCCLOUD_SCRUB_NAMES='$WORK/none' git push -q origin main 2> /dev/null"
: > "$WORK/empty.txt"
check "an empty list refuses the push" bash -c "! SYNCCLOUD_SCRUB_NAMES='$WORK/empty.txt' git push -q origin main 2> /dev/null"
check "…and a list that holds names lets it through" pushes main

fresh; says "Zorblax"
git config --add synccloud.privateRemote origin
check "a private remote skips the name check" pushes main
git config --unset-all synccloud.privateRemote
fresh

check "--scan finds a name already on the remote" bash -c "'$GUARD' --scan HEAD | grep -q 'notes:'"
check "--scan exits 1 on a hit" bash -c "'$GUARD' --scan HEAD > /dev/null; [ \$? -eq 1 ]"
git checkout -q --orphan clean2 && git rm -rqf . && echo fine > f && git add f && git commit -qm "Clean"
check "--scan exits 0 on a clean tree" "$GUARD" --scan HEAD
git checkout -q main

check "--install again says it is already installed" \
  bash -c "PRE_PUSH_GUARD_SOURCE='$GUARD' '$GUARD' --install | grep -q 'already installed'"
rm .git/hooks/pre-push && echo '#!/bin/sh' > .git/hooks/pre-push
check "--install leaves another hook alone" \
  bash -c "! PRE_PUSH_GUARD_SOURCE='$GUARD' '$GUARD' --install 2> /dev/null && grep -q '^#!/bin/sh' .git/hooks/pre-push"

echo
[ "$failures" -eq 0 ] && echo "all checks passed" || echo "$failures check(s) failed"
exit $((failures > 0))

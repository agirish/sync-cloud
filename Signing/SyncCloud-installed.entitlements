<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The installed copy's only: the Vault's key behind Touch ID (VT31). Never set in project.yml,
     which signs every build ad-hoc; an ad-hoc build claiming this would not launch. Used by
     scripts/vault-sign-installed when it asks Xcode to make the profile again. -->
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.abhishekgirish.SyncCloud</string>
	</array>
</dict>
</plist>
